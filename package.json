  "scripts": {
    "prepare": "husky install",
    "install": "ts-node tools/build/ensure-electron-better-sqlite3.ts",
    "postinstall": "patch-package",
    "lint": "eslint --fix",
    "predev": "yarn dev:sync:widget-manifests && yarn dev:sync:nocode-widget-capability-catalog",
    "dev": "vite",
    "dev:server": "vite --mode server",
    "dev:sync:widget-manifests": "ts-node --transpile-only -P tools/tsconfig.json tools/dev/sync-widget-manifests.ts",
    "dev:sync:widget-manifests:check": "ts-node --transpile-only -P tools/tsconfig.json tools/dev/sync-widget-manifests.ts --check",
    "dev:sync:nocode-widget-capability-catalog": "ts-node --transpile-only -P tools/tsconfig.json tools/dev/sync-nocode-widget-capability-catalog.ts",
    "dev:sync:nocode-widget-capability-catalog:check": "ts-node --transpile-only -P tools/tsconfig.json tools/dev/sync-nocode-widget-capability-catalog.ts --check",
    "dev:ai-openai-stream-fixture": "ts-node --transpile-only -P tools/tsconfig.json tools/dev/ai-openai-stream-fixture.ts",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:server": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build --mode server",
    "build:nas": "yarn build:nas:x64 && yarn build:nas:arm64",
    "build:nas:x64": "yarn build:nas:payload --arch x64 && yarn build:nas:synology --arch x64 && yarn build:nas:fnos --arch x64",
    "build:nas:arm64": "yarn build:nas:payload --arch arm64 && yarn build:nas:synology --arch arm64 && yarn build:nas:fnos --arch arm64",
    "build:nas:server:arm64:tgz": "ts-node tools/nas/pack-server-arm",
    "build:nas:synology:arm64": "ts-node tools/nas/prepare-synology-arm-server && yarn build:nas:payload --arch arm64 && yarn build:nas:synology --arch arm64",
    "build:nas:payload": "ts-node tools/nas/build-payload",
    "build:nas:synology": "ts-node tools/nas/build-synology-project",
    "build:nas:fnos": "ts-node tools/nas/pack-fnos-fpk",
    "prepare:docker:server": "ts-node --project tools/docker/tsconfig.json tools/docker/server prepare",
    "build:docker:server": "ts-node --project tools/docker/tsconfig.json tools/docker/server build",
    "publish:docker:server": "ts-node --project tools/docker/tsconfig.json tools/docker/server push",
    "release:body": "node tools/release/compose-release-body.js",
    "release:upload:mac": "node tools/release/upload-mac-assets.js"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix --quiet",
      "git add"
    ]
  },
