{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "strict": false,
    "jsx": "preserve",
    "declaration": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noImplicitAny": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "sourceMap": true,
    "types": [
      "vite/client",
      "element-plus/global",
      "unplugin-icons/types/vue"
    ],
    "paths": {
      "@common/*":["src/common/*"],
      "@main/*":["src/main/*"],
      "@renderer/*":["src/renderer/*"],
    }
  },
  "include": [
    "src/*", "src/**/*", "vite.config.ts"
  ]
}
