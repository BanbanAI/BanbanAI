{
  "key": "engineering-project-management",
  "name": "工程项目管理",
  "version": "0.1.0",
  "aliases": [
    "工程项目管理",
    "工程项目管理系统",
    "项目管理（工程）",
    "工程型项目管理",
    "建筑工程管理",
    "建筑工程项目管理",
    "施工项目管理",
    "工程进度管理",
    "工程项目部管理"
  ],
  "beginnerSummary": "适合建筑施工、工程建设等项目型团队，把项目档案、立项、计划进度、验收维保、现场安全、资源协同和费用结算统一放到同一条工程项目主线上；材料、设备、劳务都仍然围绕项目执行，而不是拆成独立库存或人事系统。",
  "intentExamples": [
    "帮我做一个工程项目管理系统，要有立项、进度、现场、安全整改和结算",
    "做一个建筑工程管理系统，要项目计划、进度、安全检查和技术交底",
    "我要一套施工项目管理应用，材料、设备和劳务都要围绕项目来管",
    "做一个工程进度管理系统，先把项目计划、进度填报和验收补起来",
    "我已经有项目档案了，再补一个现场日志和安全检查整改",
    "帮我做一个工程项目部管理系统，先按工程项目主线把现场和资料协同串起来",
    "给现有进度记录表加一个偏差原因字段"
  ],
  "modules": [
    {
      "key": "project-core",
      "name": "项目主线",
      "purpose": "维护项目档案、立项申请和资料归档，作为全部工程事项的主关联中心。"
    },
    {
      "key": "progress-control",
      "name": "计划进度",
      "purpose": "维护项目计划、实际进度、验收和维保节点，形成计划与执行对照。"
    },
    {
      "key": "site-safety",
      "name": "现场安全",
      "purpose": "记录施工现场日志、安全检查整改和技术交底留痕。"
    },
    {
      "key": "resource-collab",
      "name": "资源协同",
      "purpose": "围绕项目管理物资、设备和劳务等执行资源。"
    },
    {
      "key": "commercial-settlement",
      "name": "费用结算",
      "purpose": "记录项目费用、结算和经营收口事项。"
    }
  ],
