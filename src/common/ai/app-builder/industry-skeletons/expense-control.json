  "flows": [
    {
      "from": "budget-ledger",
      "to": "expense-request-form",
      "label": "预算台账约束费用申请"
    },
    {
      "from": "expense-request-form",
      "to": "loan-advance-record",
      "label": "费用申请驱动借款登记"
    },
    {
      "from": "expense-request-form",
      "to": "expense-claim",
      "label": "费用申请转入报销单"
    },
    {
      "from": "loan-advance-record",
      "to": "expense-claim",
      "label": "借款记录支持报销冲抵"
    },
    {
      "from": "expense-claim",
      "to": "public-payment-request",
      "label": "报销审批通过后触发对公付款申请"
    }
  ],
  "deferredCapabilities": [
    {
      "name": "发票 OCR 与验真",
      "reason": "属于高阶票据能力，首轮正式骨架只保留留档入口，不默认承诺自动识别与验真。"
    },
    {
      "name": "银企直联",
      "reason": "涉及支付集成与账户权限，不属于首轮默认生成对象。"
    },
    {
      "name": "自动核销",
      "reason": "依赖更细的借款与报销对账规则，首轮只保留人工冲抵链路。"
    },
    {
      "name": "复杂费用分摊",
      "reason": "跨部门或项目分摊需要额外台账与规则配置，暂不纳入首轮正式对象集。"
    },
    {
      "name": "自动凭证",
      "reason": "属于财务记账自动化能力，不在本轮最小正式落库范围内。"
    },
    {
      "name": "自动出表",
      "reason": "属于报表自动化与汇总分析能力，不在首轮默认交付范围内。"
    }
  ],
  "validationPrompts": [
    {
      "userPrompt": "做一个预算报销系统，要有预算控制、借款冲抵和报销审批",
      "expectedBehavior": "优先命中 expense-control 主链，不要退回 generic reimbursement。"
    },
    {
      "userPrompt": "做一个费控报销系统，要支持预算占用、借款核销和发票留档",
      "expectedBehavior": "优先命中 expense-control 主链，保留预算控制、借款冲抵和票据留档对象。"
    },
    {
      "userPrompt": "做一个费用报销管理系统，要支持发票识别和验真",
      "expectedBehavior": "因为明确强调发票识别与验真，优先走 expense-control，而不是只按 generic reimbursement 处理。"
    },
    {
      "userPrompt": "做一个财务报销系统，要有员工报销和票据留档",
      "expectedBehavior": "这是泛称报销需求，优先走 administrative-operations，不要把 expense-control 变成所有报销入口。"
    },
    {
      "userPrompt": "做一个财务付款管理系统，要有合同付款和对公付款协同",
      "expectedBehavior": "这是 financial-operations 主链，优先走 financial-operations，不要被 expense-control 吸收。"
    },
    {
      "userPrompt": "做一个报销系统，要自动验真、银企直联和自动出表",
      "expectedBehavior": "可以命中 expense-control，但要明确 OCR 验真、银企直联与自动出表仍作为 deferred capability，不能默认承诺已正式落库。"
    }
  ]
}
