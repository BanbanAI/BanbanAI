{
  "key": "expense-control",
  "name": "费控报销",
  "version": "0.1.0",
  "aliases": [
    "费控",
    "费控报销",
    "预算报销",
    "预算费用报销管理",
    "借款冲抵报销",
    "发票识别报销",
    "发票识别和验真"
  ],
  "beginnerSummary": "适合管理预算控制、费用申请、借款冲抵、报销审批和票据留档，但不默认承诺 OCR 验真、银企直联和自动核销。",
  "intentExamples": [
    "做一个预算报销系统，要有预算控制、借款冲抵和报销审批",
    "做一个费控报销系统，要管预算占用、借款核销和报销审批",
    "做一个预算费用报销管理系统，要有费用申请、报销单和对公付款申请",
    "做一个费用报销管理系统，要支持发票识别",
    "做一个费用报销管理系统，要支持发票识别和验真"
  ],
  "modules": [
    {
      "key": "budget-control",
      "name": "预算控制",
      "purpose": "管理预算台账与费用申请的预算占用。"
    },
    {
      "key": "expense-reimbursement",
      "name": "报销与借款",
      "purpose": "管理费用申请、借款记录和报销审批主链。"
    },
    {
      "key": "payment-invoice",
      "name": "付款与票据",
      "purpose": "管理对公付款申请与发票留档等轻量增强对象。"
    }
  ],
