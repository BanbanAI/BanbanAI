  "modules": [
    {
      "key": "risk-management",
      "name": "风险管理",
      "purpose": "识别风险点、维护风险分级并为后续排查与整改提供基础。"
    },
    {
      "key": "hazard-governance",
      "name": "隐患治理",
      "purpose": "承接隐患排查任务、整改责任和复查闭环。"
    },
    {
      "key": "incident-management",
      "name": "事故管理",
