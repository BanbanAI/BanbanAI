  "deferredCapabilities": [
    {
      "name": "安全绩效考核与评分看板",
      "reason": "依赖企业自定义口径和评分规则，不适合作为首轮默认能力。"
    },
    {
      "name": "行业化巡更路线与电子点位打卡",
      "reason": "当前证据更适合作为模板参考样本，尚不足以固化成通用一级骨架默认切片。"
    },
    {
      "name": "设备全生命周期与维修保养",
      "reason": "设备申购、维修、保养和报废应继续归设备运维家族处理，EHS 仅保留安全点检切片。"
    },
    {
      "name": "环保排放监测与政府报送",
      "reason": "需要更完整的环保合规证据和口径，当前不应默认展开。"
    }
  ],
  "validationPrompts": [
    {
      "userPrompt": "帮我做一个EHS系统，要管隐患、风险、事故、危废和职业健康",
      "expectedBehavior": "触发 ehs-safety 主骨架，生成风险、隐患、事故、危废、职业健康和培训切片，不自动补全设备全生命周期。"
    },
    {
      "userPrompt": "做一个安全管理平台，要有隐患排查和整改闭环",
      "expectedBehavior": "优先生成隐患排查任务、隐患整改记录和风险评估，不误路由到设备运维或工单管理。"
    },
    {
      "userPrompt": "做一个隐患管理系统，支持排查任务、整改责任人和复查",
      "expectedBehavior": "作为 ehs-safety 的隐患治理切片处理，保留排查到整改的闭环主线。"
    },
    {
      "userPrompt": "做一个危废品管理系统，要记录台账、暂存和转运去向",
      "expectedBehavior": "生成危废台账和危废转运记录切片，不误并入进销存。"
    },
    {
      "userPrompt": "做一个劳保用品管理系统，要管发放领用和库存预警",
      "expectedBehavior": "生成劳保用品台账和劳保领用记录切片，不误并入行政运营或进销存。"
    },
    {
      "userPrompt": "我要扫码做设备安全点检，并把异常转成隐患",
      "expectedBehavior": "生成设备安全点检增强切片并关联隐患整改，不自动扩成设备申购、维修、保养或报废主链。"
    },
    {
      "userPrompt": "给我做职业健康档案和安全培训台账",
      "expectedBehavior": "生成职业健康档案和安全培训切片，不误路由到完整 HRM 主档。"
