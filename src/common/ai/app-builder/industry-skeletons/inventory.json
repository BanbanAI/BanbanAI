  "validationPrompts": [
    {
      "userPrompt": "帮我搭一个进销存系统，要有产品、客户、供应商、采购入库、销售出库和库存盘点。",
      "expectedBehavior": "触发 inventory 的 foundation，生成主数据、采购、销售和库存基础单据，不默认加入发票和收付款。"
    },
    {
      "userPrompt": "我想做销售订单和出库流程，客户能分价格等级，产品要有不同售价。",
      "expectedBehavior": "触发 inventory 的销售切片，并补上产品销售价格表，不扩展完整采购和财务模块。"
    },
    {
      "userPrompt": "我已经有客户和产品表，帮我补采购订单、采购入库和供应商管理。",
      "expectedBehavior": "复用已有客户/产品上下文，只补采购相关切片和必要关系。"
    },
    {
      "userPrompt": "把现有销售订单表单新增一个客户联系人手机字段。",
      "expectedBehavior": "视为局部编辑，不重新触发整套行业骨架。"
    },
    {
      "userPrompt": "我要在进销存里增加应收对账、收款单和资金账户。",
      "expectedBehavior": "基于 inventory 已有骨架补财务增强切片，并明确这是 enhancement，不是默认首轮输出。"
    },
    {
      "userPrompt": "做一个无库存版进销存，只管产品、客户、供应商、销售订单、采购订单和收付款。",
      "expectedBehavior": "触发 inventory 的轻量交易切片，保留产品、客户、供应商、销售订单、采购订单、收付款单，不默认生成仓库、出入库和库存调整；只有用户明确需要账户管理时，再补资金账户。"
    },
    {
      "userPrompt": "做一个极简版现结进销存，保留仓库和出入库，但收付款直接挂订单。",
      "expectedBehavior": "触发 inventory 的现结库存切片，保留产品、仓库、客户、供应商、销售订单、销售出库、采购订单、采购入库、收款单和付款单，不默认生成应收应付对账、独立发票表和资金账户。"
    },
