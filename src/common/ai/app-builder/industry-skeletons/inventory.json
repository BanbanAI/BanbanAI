{
  "key": "inventory",
  "name": "进销存",
  "version": "0.1.0",
  "aliases": [
    "进销存系统",
    "库存管理",
    "采购销售库存",
    "仓储进销存",
    "无库存进销存",
    "简化版进销存",
    "极简版进销存",
    "赊销进销存",
    "现结进销存",
    "极简版-现结"
  ],
  "beginnerSummary": "适合管理产品、客户、供应商、采购销售、库存变动，以及常见的收付款与对账；如果明确不做库存，或只想做订单直连收付款，也可裁剪成轻量交易管理。",
  "intentExamples": [
    "帮我搭一个进销存系统",
    "做一个采购、销售、库存一体的管理应用",
    "我想管理仓库、客户和供应商，还要能做入库出库",
    "给我一个带销售订单和采购订单的库存系统",
    "做一个无库存版进销存，只管采购、销售和收付款",
    "做一个极简版现结进销存，保留仓库和出入库，但收付款直接挂订单"
  ],
  "modules": [
    {
      "key": "master-data",
      "name": "基础资料",
      "purpose": "维护产品、客户、供应商、仓库及价格体系等基础对象。"
    },
    {
      "key": "sales",
      "name": "销售管理",
      "purpose": "管理销售前置报价、销售订单、出库和退货。"
    },
    {
      "key": "procurement",
      "name": "采购管理",
      "purpose": "管理采购订单、采购入库和采购退货。"
    },
    {
      "key": "inventory",
      "name": "库存管理",
      "purpose": "处理其他出入库、调拨、盘点等库存变动。"
    },
    {
      "key": "finance",
      "name": "财务增强",
      "purpose": "承接订单直连收付款、对账、发票和可选资金账户。"
    }
  ],
