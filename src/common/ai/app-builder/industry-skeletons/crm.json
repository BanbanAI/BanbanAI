  "deferredCapabilities": [
    {
      "name": "库存联动",
      "reason": "版本 3/4/6 证明库存是常见增强方向，但不应默认进入所有 CRM。"
    },
    {
      "name": "生产工单与生产计划",
      "reason": "只在生产版明确出现，适合作为后续扩展。"
    },
    {
      "name": "销售目标管理",
      "reason": "伙伴云完整 CRM 将季度销售目标和达成监控并入模板，但这更像经营/绩效扩展，不应默认进入所有 CRM。"
    },
    {
      "name": "售后服务工单",
      "reason": "阿里宜搭与伙伴云外部样本都明显出现，更适合作为后续扩展或未来独立售后骨架。"
    },
    {
      "name": "薪酬绩效管理",
      "reason": "仅标准版明显强调，通用性不足，且容易把 CRM 扩大成绩效系统。"
    },
    {
      "name": "复杂经营看板与趋势分析",
      "reason": "展示层依赖具体口径，不适合在首轮骨架中固化。"
    },
    {
      "name": "自动分配、自动转客户、自动统计",
      "reason": "属于规则和自动化能力，不是基础骨架本体。"
    }
  ],
  "validationPrompts": [
    {
      "userPrompt": "帮我搭一个标准CRM，要有线索、客户、商机、报价、订单和回款。",
      "expectedBehavior": "触发 crm 标准切片，生成获客、客户、商机、订单和轻财务主链，不默认加库存和生产。"
    },
    {
      "userPrompt": "做一个极简CRM，只要产品、客户、销售订单和收款。",
      "expectedBehavior": "触发 crm 极简切片，只生成产品、客户、联系人、销售订单和回款单，不默认生成线索、商机和绩效模块。"
    },
