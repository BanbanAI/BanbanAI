{
  "key": "crm",
  "name": "客户管理",
  "version": "0.1.0",
  "aliases": [
    "CRM",
    "客户关系管理",
    "客户管理CRM",
    "销售管理",
    "销售管理系统",
    "销售订单管理",
    "订单型CRM",
    "门店销售管理",
    "商机管理",
    "销售线索管理",
    "客户商机管理",
    "销售合同管理",
    "合同回款管理",
    "CRM Pro",
    "极简CRM",
    "库存CRM",
    "生产CRM",
    "制造业CRM",
    "软高科CRM"
  ],
  "beginnerSummary": "适合管理潜在客户、正式客户、联系人、跟进记录、销售机会、报价、订单或合同，以及常见开票和收款流程；如果你要做订单驱动销售管理、门店合同回款、库存协同或生产履约，也可以在这个骨架上继续裁剪扩展。",
  "intentExamples": [
    "帮我搭一个CRM系统",
    "做一个客户和商机管理系统",
    "我要一个带跟进记录和销售订单的销售管理应用",
    "做一个客户、商机、合同和回款的一体化CRM",
    "做一个极简CRM，只管客户、订单和收款",
    "做一个带销售出库的库存CRM",
    "做一个订单后接生产工单的生产型CRM",
    "做一个销售管理极简版，不要商机和报价，只要订单、开票和回款",
    "做一个门店销售管理，要公海客户、合同回款和售后处理"
  ],
  "modules": [
    {
      "key": "product",
      "name": "产品管理",
      "purpose": "维护销售中会被报价、商机和订单复用的产品基础资料。"
    },
    {
      "key": "lead",
      "name": "获客与线索",
      "purpose": "承接市场活动、活动管理话术下的潜在客户线索，以及后续转化。"
    },
    {
      "key": "customer",
      "name": "客户管理",
      "purpose": "维护客户、联系人与销售跟进记录。"
    },
    {
      "key": "sales",
      "name": "商机与订单",
      "purpose": "推进销售机会、报价与正式成交单据；在部分 CRM 中，成交单据也可能以销售合同命名。"
    },
    {
      "key": "finance",
      "name": "开票与收款",
      "purpose": "承接订单或合同的回款计划、开票需求和真实收付款记录。"
    }
  ],
