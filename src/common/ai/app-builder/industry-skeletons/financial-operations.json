  "validationPrompts": [
    {
      "userPrompt": "做一个财务管理系统，要有合同台账、应收应付、收付款和付款提醒",
      "expectedBehavior": "命中完整 financial-operations 主链，不生成总账和报表。"
    },
    {
      "userPrompt": "做一个收支管理系统，要有应收应付、收付款和发票留档",
      "expectedBehavior": "命中合同台账和收付款执行主链，发票只作为轻量增强对象。"
    },
    {
      "userPrompt": "做一个财务付款管理系统，要有应付合同、对公付款和付款台账",
      "expectedBehavior": "命中 payment-execution 切片，不扩成采购库存主链。"
    },
    {
      "userPrompt": "做一个项目合同管理系统，要按项目看回款和付款记录",
      "expectedBehavior": "命中 financial-operations 的项目维度合同收支切片，不改走 project-management。"
    },
    {
      "userPrompt": "做一个合同管理系统，要有合同、回款、付款和发票记录",
      "expectedBehavior": "命中财务协同里的合同收支主链，不改走 crm 销售主链。"
    },
    {
      "userPrompt": "做一个财务报销系统，要有员工报销和票据留档",
      "expectedBehavior": "当前正式仍应优先走 administrative-operations，而不是 financial-operations。"
    }
  ]
