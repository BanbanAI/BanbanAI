  "deferredCapabilities": [
    {
      "name": "发票 OCR 与验真",
      "reason": "属于高级能力，不应在首轮正式骨架默认承诺。"
    },
    {
      "name": "银企直联",
      "reason": "属于支付集成能力，不是首轮默认生成对象。"
    },
    {
      "name": "自动核销",
      "reason": "依赖更深的财务规则与自动化。"
    },
    {
      "name": "自动凭证",
      "reason": "属于高阶会计能力，不在首轮正式对象范围内。"
    },
    {
      "name": "自动出表",
      "reason": "属于高阶会计能力，不在首轮正式对象范围内。"
    },
    {
      "name": "电子合同生成",
      "reason": "属于高阶能力外延，不应直接下沉进首轮骨架。"
    }
