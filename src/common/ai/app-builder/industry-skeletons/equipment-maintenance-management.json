  "flows": [
    {
      "from": "equipment-ledger",
      "to": "inspection-plan",
      "label": "设备建立后可配置巡检计划"
    },
    {
      "from": "inspection-plan",
      "to": "inspection-record",
      "label": "按计划执行并登记巡检记录"
    },
    {
      "from": "equipment-ledger",
      "to": "point-check-record",
      "label": "设备可补充点检执行记录"
    },
    {
      "from": "inspection-record",
      "to": "repair-work-order",
      "label": "巡检异常可转维修工单"
    },
    {
      "from": "equipment-ledger",
      "to": "maintenance-record",
      "label": "设备可补充保养记录"
    }
  ],
  "deferredCapabilities": [
    {
      "name": "扫码巡检与一物一码入口",
      "reason": "属于移动执行入口增强，首轮不作为所有设备运维场景的默认前置。"
    },
    {
      "name": "备件库存与自动补货",
      "reason": "更适合作为库存协同增强，而不是设备运维首轮默认对象。"
    },
    {
      "name": "预测性维护与状态分析看板",
      "reason": "依赖持续数据积累和高级分析能力，不应在首轮默认生成。"
    },
    {
      "name": "报废处置与行政资产折旧联动",
      "reason": "涉及行政资产与财务规则边界，不宜在当前设备运维骨架中默认展开。"
    }
  ],
  "validationPrompts": [
    {
      "userPrompt": "帮我做一个设备巡检系统，要有设备台账、巡检记录和异常报修",
      "expectedBehavior": "命中 equipment-maintenance-management foundation，生成设备台账、巡检计划、巡检记录和维修工单，不误并入行政资产或工单管理。"
    },
    {
      "userPrompt": "做一个设备管理与巡检系统，包含设备档案、点检、保养和维修",
      "expectedBehavior": "命中同一设备运维骨架，补点检记录和保养记录增强，不扩成库存备件系统。"
    },
    {
      "userPrompt": "做一个设备台账管理系统",
      "expectedBehavior": "仍归 equipment-maintenance-management 的台账入口，保留后续接巡检和维修的空间，不单独新建 asset-management skeleton。"
    },
    {
      "userPrompt": "做一个设备点检管理系统，异常要转维修",
      "expectedBehavior": "触发设备点检切片并接维修工单，不误路由到 EHS 安全检查。"
    },
    {
      "userPrompt": "做一个设备扫码巡检系统",
      "expectedBehavior": "仍归 equipment-maintenance-management，可保留扫码入口为增强能力，不单独新建设备扫码 skeleton。"
    },
    {
      "userPrompt": "做一个设备管理系统，后续要接巡检和维修",
      "expectedBehavior": "归 equipment-maintenance-management 的通用设备入口，先生成设备台账主链，并为后续巡检与维修保留扩展空间。"
    },
    {
      "userPrompt": "做一个模具管理系统，要管领用、维修、保养和报废",
      "expectedBehavior": "仍归 equipment-maintenance-management，作为制造工装垂直切片处理，不单独新建 mold-management skeleton。"
    },
    {
      "userPrompt": "给现有巡检记录表增加一个巡检照片字段",
      "expectedBehavior": "识别为局部编辑，不重新触发整套行业骨架。"
    }
  ]
}
