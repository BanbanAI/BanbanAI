  <script>
    (function () {
      function detectIframe() {
        try {
          return window.self !== window.top;
        } catch (error) {
          return true;
        }
      }

      window.__IS_IN_IFRAME__ = detectIframe();

      if (window.__IS_IN_IFRAME__) {
        document.documentElement.classList.add("is-in-iframe");
      }
    })();
  </script>
  <style>
    html.is-in-iframe .header-wrapper {
      display: none !important;
    }
  </style>
  <script>
    function changeLang(lang) {
      let path = window.location.pathname;
      const langPatterns = ['zh', 'en', 'jp', 'ja'];
      let newPath = path;
      let changed = false
      for (let pattern of langPatterns) {
        if (path.includes(`/${pattern}/`)) {
          changed = true
          newPath = path.replace(`/${pattern}/`, `/${lang}/`);
          break;
        }

        if (path == `/${pattern}`) {
          changed = true
          newPath = `/${lang}`
          break
        };
      }
      if (!langPatterns.some(pattern => path.includes(`/${pattern}/`)) && !changed) {
        newPath = `/${lang}${path}`;
      }
      window.location.href = newPath;
    }
    document.addEventListener("DOMContentLoaded", () => {
      if (window.__IS_IN_IFRAME__) {
        document.body.classList.add("is-in-iframe");
      }

      const links = document.querySelectorAll(".contentWrap a");

      links.forEach((link) => {
        link.addEventListener("click", (event) => {
          event.preventDefault(); // 阻止默认跳转行为
          const targetId = link.getAttribute("href"); // 获取目标锚点 ID
          const targetElement = document.querySelector(targetId);

          if (targetElement) {
            // 计算目标位置并减去 100px
            const targetPosition =
              targetElement.getBoundingClientRect().top + window.pageYOffset - 100;

            // 平滑滚动到目标位置
            window.scrollTo({
              top: targetPosition,
              behavior: "smooth",
            });
          }
        });
      });

      // 监听滚动事件，当页面滚动时改变header样式
      const header = document.querySelector(".header-wrapper");
      window.addEventListener("scroll", () => {
        if (!header) {
          return;
        }
        if (window.scrollY > 50) {
          header.classList.add("scrolled");
        } else {
          header.classList.remove("scrolled");
        }
      });
    });
  </script>
